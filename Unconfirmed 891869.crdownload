import pandas as pd
import numpy as np
from sklearn.preprocessing import MinMaxScaler

# Creating a sample dataset
data = {
    "Feature1": [100, 200, 300, 400, 500],
    "Feature2": [10, 20, 30, 40, 50]
}
df = pd.DataFrame(data)

# Applying Min-Max Scaling
